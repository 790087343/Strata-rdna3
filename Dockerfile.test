FROM strata-hip:engine-v0144.1-rocm101-vision-cpu-test
COPY . /opt/strata-rdna3
WORKDIR /opt/strata-rdna3
RUN curl -fL --retry 3 https://github.com/ROCm/rocWMMA/archive/1ab208f49945c38626b79e3f0c284d65ac44a781.tar.gz -o /opt/rocwmma.tar.gz && mkdir /opt/rocwmma-pinned && tar -xzf /opt/rocwmma.tar.gz --strip-components=1 -C /opt/rocwmma-pinned
RUN /opt/strata/.venv/bin/cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DSTRATA_ENABLE_HIP=ON -DSTRATA_PREFILL_MMQ=ON -DSTRATA_MMQ_KQUANTS=ON -DCMAKE_HIP_ARCHITECTURES=gfx1100 -DCMAKE_HIP_COMPILER=/opt/rocm/llvm/bin/clang++ -DCMAKE_HIP_COMPILER_ROCM_ROOT=/opt/rocm "-DCMAKE_HIP_FLAGS=--rocm-path=/opt/rocm --rocm-device-lib-path=/opt/rocm/amdgcn/bitcode" -DSTRATA_ROCWMMA_INCLUDE_DIR=/opt/rocwmma-pinned/library/include -DSTRATA_GGML_DIR=/opt/strata/third_party/llama.cpp -DSTRATA_BUILD_TESTS=OFF && /opt/strata/.venv/bin/cmake --build build -j8
ENV LD_LIBRARY_PATH=/opt/rocm/lib
RUN ./build/strata --version
ENTRYPOINT ["/opt/strata/.venv/bin/python"]
